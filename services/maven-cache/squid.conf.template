# squid 5/6 config for transparent caching MITM. Rendered at
# container start by entrypoint.sh — env vars expanded with envsubst.
#
# Layers:
#   - Listen :8081 as an HTTP forward proxy with ssl_bump.
#   - For whitelisted CDN hosts → ssl_bump bump (decrypt + cache).
#     Everything else → ssl_bump splice (pass through, no MITM, no
#     cache). Mojang auth/skin domains aren't even routed here
#     (NO_PROXY on the MC container), so we never see them — but
#     the splice rule is the safety net if a future MC container
#     forgets to set NO_PROXY.
#   - Cache 40 GB on disk, 500 MB max object size (CF mod jars are
#     typically <100 MB but some bundled modpack files cross that).
#   - When UPSTREAM_PROXY is set, send everything through gost on
#     127.0.0.1:8082 (HTTP forward), which gost chains via
#     UPSTREAM_PROXY (xray on host). When unset, squid goes direct.

visible_hostname maven-cache

# Listening port: ssl_bump enabled, cert= points at the CA seeded
# into the shared volume by the panel. generate-host-certificates=on
# tells squid to mint a leaf for each MITM'd host on the fly.
http_port 8081 ssl-bump \
    cert=/etc/cofemine/ca/ca.crt \
    key=/etc/cofemine/ca/ca.key \
    generate-host-certificates=on \
    dynamic_cert_mem_cache_size=8MB

# Dynamic certificate generator — squid's helper that signs leaf
# certs at request time. The on-disk db caches them so we don't
# regenerate the same google.com leaf 1000 times.
sslcrtd_program /usr/lib/squid/security_file_certgen -s /var/spool/squid/ssl_db -M 8MB
sslcrtd_children 5

# Trust the CA chain coming in from the upstream (chain through gost
# → xray → CDN). We MUST validate the real CDN's cert, otherwise we
# happily MITM a man-in-the-middle. Default CA bundle is fine.
tls_outgoing_options cafile=/etc/ssl/certs/ca-certificates.crt

# Domains we WANT to MITM (so we can cache jar bodies). Everything
# else is spliced. Pattern is dstdomain because ssl_bump uses SNI.
acl mitm_domains ssl::server_name .forgecdn.net
acl mitm_domains ssl::server_name .curseforge.com
acl mitm_domains ssl::server_name .modrinth.com
acl mitm_domains ssl::server_name .neoforged.net
acl mitm_domains ssl::server_name .minecraftforge.net
acl mitm_domains ssl::server_name .fabricmc.net
acl mitm_domains ssl::server_name .quiltmc.org
# Mojang is deliberately NOT here. The only thing keeping player auth
# away from this proxy is NO_PROXY on the MC container, and an untrusted
# mod ignores NO_PROXY at will. Bumping *.mojang.com would decrypt
# session tokens and write them into access_log; splicing means we
# tunnel them without ever holding the plaintext. There is nothing
# cacheable on those endpoints anyway — the cacheable Mojang paths
# (piston-data / piston-meta / libraries) go through nginx on :80, not
# through squid.

# at_step ACLs — squid evaluates ssl_bump rules at distinct phases of
# the TLS handshake. step1=ClientHello received (we peek to learn the
# SNI), step2=ServerHello received (we now know which side wants what
# and can decide bump vs splice), step3=peer cert validated.
acl step1 at_step SslBump1
acl step2 at_step SslBump2
acl step3 at_step SslBump3

# Peek at TLS ClientHello → decide bump vs splice per SNI.
ssl_bump peek step1
ssl_bump bump step2 mitm_domains
ssl_bump splice all

# ---- Access control -------------------------------------------------
#
# :8081 is reachable by every container on cofemine_mcnet, and the agent
# hands each MC container HTTPS_PROXY=http://maven-cache:8081. That makes
# this an open forward proxy from the point of view of any mod running
# inside a Minecraft server — i.e. arbitrary untrusted code. The rules
# below take away the parts of that which are dangerous:
#
#   • cloud instance-metadata (169.254.169.254) — hands out IAM
#     credentials for the whole host to anything that can issue a plain
#     GET. This is the single highest-value target reachable from here.
#   • RFC1918 / loopback / link-local — the docker networks, the panel's
#     own API and Postgres, and anything else listening on the host.
#     Requests to the real CDNs never resolve here.
#   • non-web ports, and CONNECT to anything but 443 — stops the proxy
#     being used as a generic TCP tunnel into the internal network.
#
# `http_access allow all` stays for now: MC containers route *all* their
# HTTPS through here, including mod downloads hosted outside the CDN
# allowlist (GitHub releases, CF mirrors). Narrowing to a dstdomain
# allowlist needs a week of access_log first — see the hardening plan.
acl SSL_ports port 443
acl Safe_ports port 80
acl Safe_ports port 443
acl CONNECT method CONNECT

acl to_metadata dst 169.254.169.254/32
acl to_linklocal dst 169.254.0.0/16
acl to_linklocal dst fe80::/10
acl to_private dst 10.0.0.0/8
acl to_private dst 172.16.0.0/12
acl to_private dst 192.168.0.0/16
acl to_private dst 127.0.0.0/8
acl to_private dst fc00::/7
acl to_private dst ::1/128

# This container's own nginx layer (loader installer mirror on :80) is a
# legitimate destination even though it resolves to a docker-private
# address. MC containers are supposed to reach it directly — NO_PROXY
# and the JVM's nonProxyHosts both list `maven-cache` — but a tool that
# ignores those would hit the deny below and fail a loader install, so
# allow it explicitly rather than depend on client-side config.
acl to_cache dstdomain maven-cache

# Optional source restriction. In prod this container also joins the
# shared external Caddy network, so a container belonging to any other
# stack on that network can reach :8081 and use it as a forward proxy to
# the internet. The deny rules below stop it reaching anything private,
# but not the open-proxy part.
#
# Set MCNET_CIDR (e.g. 172.28.0.0/16 — check `docker network inspect
# cofemine_mcnet`) to lock the proxy to Minecraft containers. Left unset
# the block is empty and behaviour is unchanged, because the subnet is
# assigned dynamically by Docker and hardcoding a guess would break
# every install.
${SQUID_SRC_BLOCK}

# Cache-manager interface: never expose it to the mcnet.
http_access deny manager

http_access deny to_metadata
http_access deny !Safe_ports
http_access deny CONNECT !SSL_ports
http_access allow to_cache
http_access deny to_linklocal
http_access deny to_private

http_access allow all

# On-disk cache: 40 GB across 16 L1 / 256 L2 dirs.
cache_dir aufs /var/spool/squid 40000 16 256
maximum_object_size 500 MB
maximum_object_size_in_memory 4 MB
cache_mem 256 MB
coredump_dir /var/spool/squid

# Aggressive cache for jar/zip/pack — they're immutable by URL once
# published. Long TTL, refresh only on explicit no-cache.
refresh_pattern -i \.(jar|zip|tar\.gz|tgz|pack)(\?|$)  10080 100% 525600 override-expire ignore-no-cache ignore-private
refresh_pattern -i \.(json|xml|sha1|sha256|md5)(\?|$)    30  50%   1440
refresh_pattern .                                         0  20%    4320

# Disable the via header to reduce CDN edge fingerprinting.
via off
forwarded_for delete
httpd_suppress_version_string on

# Logging — minimal to keep the container compact. squid still
# rotates them itself.
access_log stdio:/dev/stdout squid
cache_log stdio:/dev/stderr

# Upstream chain. When UPSTREAM_PROXY is set, entrypoint.sh launches
# gost as an HTTP forward proxy on 127.0.0.1:8082 and appends the
# cache_peer + never_direct stanza below at render time. When
# unset, this section is empty and squid goes direct.
${SQUID_PEER_BLOCK}

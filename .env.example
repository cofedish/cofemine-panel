# ===== Panel API =====
API_PORT=4000
API_HOST=0.0.0.0
# Public base URL of the API (used by the web app). When running compose, panel-web talks to panel-api via service DNS.
API_PUBLIC_URL=http://localhost:4000

# Postgres
POSTGRES_USER=cofemine
POSTGRES_PASSWORD=cofemine
POSTGRES_DB=cofemine
POSTGRES_PORT=5432
DATABASE_URL=postgresql://cofemine:cofemine@db:5432/cofemine?schema=public

# Auth
# Minimum 32 characters and NOT a placeholder — the API refuses to boot
# otherwise. Generate: openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-string
SESSION_TTL_HOURS=168

# Encryption key for secrets stored in DB (base64 32 bytes). Generate: openssl rand -base64 32
SECRETS_KEY=REPLACE_WITH_BASE64_32B

# Which peers may set X-Forwarded-For. req.ip drives the rate limiter's
# bucket and the IP recorded in the audit log, so trusting everyone lets
# any client forge both. Accepts proxy-addr presets and CIDRs.
# The default covers Caddy -> web -> api on the private docker networks.
#
# Caveat: if your own clients also arrive from a private range (LAN,
# VPN, Tailscale), they are inside the trusted set and can forge their
# own X-Forwarded-For. A hop count is tighter — set TRUST_PROXY to the
# number of proxies in front of the API (1 without Caddy, 2 with it) —
# but a wrong count buckets every client together in the rate limiter,
# so verify req.ip in the audit log after changing it.
TRUST_PROXY=loopback,linklocal,uniquelocal

# Public origin of the panel as your friends reach it, e.g.
# https://panel.example.com. Used to build the /p/* client-pack links.
# Leave empty and those links are derived from the request's Host
# header, which the client controls.
PUBLIC_BASE_URL=

# Optional shared secret for POST /auth/setup (min 16 chars). ⚠️ Ships
# EMPTY, i.e. first-run setup is trust-on-first-use: whoever calls it
# first while the user table is empty becomes OWNER. Set this — or the
# BOOTSTRAP_OWNER_* trio below — before exposing a fresh panel.
SETUP_TOKEN=

# Bootstrap: if set, first-run setup will auto-create this owner on startup (optional)
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_USERNAME=
BOOTSTRAP_OWNER_PASSWORD=

# ===== Node Agent (default "local" node) =====
AGENT_PORT=4100
AGENT_HOST=0.0.0.0
# Shared secret the API uses to authenticate against this agent
AGENT_TOKEN=change-me-agent-token
# Host paths for persistent server data + backups. The agent and every
# Minecraft container it spawns bind-mount these at the same path, so
# mods/plugins/worlds written by itzg stay visible to the agent (and to
# the panel's Installed view / file manager).
DATA_ROOT=/var/lib/cofemine/servers
BACKUP_ROOT=/var/lib/cofemine/backups
# Docker network that MC containers should join (optional)
AGENT_DOCKER_NETWORK=cofemine_mcnet
# Label prefix for managed containers
AGENT_LABEL_PREFIX=cofemine
# itzg / mc-image-helper retry knobs during modpack install (Modrinth /
# CurseForge). Bump these when forgecdn.net is flaky from your region —
# each retry resumes the install (already-downloaded jars are kept).
# These only affect the install phase, not the running MC server.
AGENT_MC_MAX_RETRIES=10
AGENT_MC_RETRY_BACKOFF=10

# ===== Web =====
WEB_PORT=3000
# NOTE: the web app deliberately has no NEXT_PUBLIC_* API URL — it calls
# the API same-origin through the /api rewrite. Don't add one back.

# ===== maven-cache =====
# ⚠️ Both of these ship EMPTY, which means the protections they control
# are OFF in a default deployment. They are empty because the correct
# value is site-specific (Docker assigns these subnets dynamically) and a
# wrong guess breaks every install. Fill them in on a real deployment.
#
# MCNET_CIDR — who may use squid as a forward proxy. In production the
# maven-cache container also joins the shared external Caddy network, so
# while this is empty a container from ANY other stack on that network
# can proxy through it to the internet. Find the value with
#   docker network inspect cofemine_mcnet
# e.g. MCNET_CIDR=172.28.0.0/16
MCNET_CIDR=
# TRUSTED_PROXY_CIDR — the reverse proxy in front of the public mirror.
# While empty, nginx keys its rate limits on Caddy's container IP, so the
# whole mirror shares one bucket: abusers aren't isolated and a genuine
# launcher can trip the limit for everyone. Set it to the Caddy network's
# subnet. Never 0.0.0.0/0 — that lets any client spoof its own key.
TRUSTED_PROXY_CIDR=

# ===== Host protection for Minecraft containers =====
# These containers are created by the agent, not by compose, so the
# `logging:` and `cap_drop:` keys in docker-compose.yml never reach them.
# A Minecraft server runs mod jars — unmoderated third-party code from
# CurseForge/Modrinth — as its own process, so this is the boundary that
# matters most on a single-node deployment.
#
# Log rotation. Containers otherwise inherit the daemon default, which
# for json-file is UNBOUNDED: a crash-looping server fills the host
# partition and takes Postgres, backups and Docker down with it. Empty
# AGENT_MC_LOG_MAX_SIZE restores the old (unbounded) behaviour.
AGENT_MC_LOG_MAX_SIZE=10m
AGENT_MC_LOG_MAX_FILE=3
# Drop every Linux capability except the seven itzg needs to chown /data
# and gosu down to uid 1000. Verified on itzg/minecraft-server:java21.
# Zero performance cost. Set to false only if you need spark's native
# async-profiler (it wants SYS_PTRACE); spark's JVM sampler still works.
AGENT_MC_CAP_DROP=true
# Sandboxed OCI runtime for MC containers ONLY — the panel's own services
# stay on runc. This is the one measure that puts a kernel boundary
# between mod code and the host; everything else assumes the kernel holds.
#   kata-runtime  own kernel per container, needs /dev/kvm (bare metal or
#                 a VM with nested virt). Near-native I/O via virtio —
#                 the right pick for a latency-sensitive game server.
#   runsc         gVisor, no KVM needed, but intercepts syscalls in
#                 userspace: measure tick times before committing.
# Must already be registered in /etc/docker/daemon.json. Empty = runc.
AGENT_MC_RUNTIME=
# nofile ulimit for MC containers. Empty = inherit the daemon's. A big
# modpack legitimately opens thousands of descriptors, so treat this as a
# ceiling against exhaustion, not a budget. e.g. 16384
AGENT_MC_NOFILE=

# ===== Integrations =====
MODRINTH_USER_AGENT=cofemine-panel/0.1 (https://github.com/cofemine/panel)
# CurseForge API key is stored via the Integrations UI (optional at start)
